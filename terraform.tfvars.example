# Standard deployment (works with Contributor role)
resource_groups = {
  "rg-rally-dev" = {
    name     = "rg-rally-dev-centralindia"
    location = "centralindia"
    tags = {
      Environment = "dev"
      Project     = "rally-tech"
      ManagedBy   = "Terraform"
    }
  }
}

user_assigned_identities = {
  "id-app-runner" = {
    name               = "uai-rally-dev-apprunner"
    location           = "centralindia"
    resource_group_key = "rg-rally-dev"
    tags = {
      Environment = "dev"
      Project     = "rally-tech"
    }
  }
}

